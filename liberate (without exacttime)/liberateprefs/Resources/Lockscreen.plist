<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>Lockscreen Tweaks</string>
	<key>items</key>
	<array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Lockscreen</string>
            <!--<key>footerText</key>
            <string>Lockscreen tint alpha.</string>-->
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
        </dict>
        <dict> <!-- HIDE NO OLDER NOTIFICATIONS-->
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>degarni.tweaks.liberate</string>
			<key>key</key>
			<string>hideNoOlderNotifs</string>
			<key>label</key>
			<string>Hide "No Older Notifications"</string>
			<key>PostNotification</key>
			<string>degarni.tweaks.liberate/preferences.changed</string>
		</dict>
        <dict> <!-- REPLACE CARRIER WITH TIME -->
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>degarni.tweaks.liberate</string>
			<key>key</key>
			<string>statusBarShowTimeLS</string>
			<key>label</key>
			<string>Time in LS Status Bar</string>
			<key>PostNotification</key>
			<string>degarni.tweaks.liberate/preferences.changed</string>
		</dict>
	</array>
	<key>title</key>
	<string>Lockscreen Tweaks</string>
</dict>
</plist>